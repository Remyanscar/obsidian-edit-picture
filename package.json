{
  "name": "obsidian-edit-picture",
  "version": "1.0.0",
  "description": "Removes black backgrounds or inverts colors of images directly within Obsidian notes.",
  "main": "main.js",
  "type": "module",
  "author": "Remyanscar",
  "license": "0-BSD",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "eslint": "^10.12.0",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "obsidian": "latest",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.1"
  },
  "overrides": {
    "moment": "^2.30.2",
    "eslint": "$eslint"
  },
  "allowScripts": {
    "esbuild@0.25.5": true
  }
}
